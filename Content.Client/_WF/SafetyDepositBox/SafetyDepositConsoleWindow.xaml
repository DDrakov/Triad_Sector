<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      MinSize="900 600"
                      SetSize="900 600"
                      Title="{Loc 'safety-deposit-console-title'}">
    <BoxContainer Orientation="Vertical" Margin="5">
        <Label Text="{Loc 'safety-deposit-console-header'}"
               StyleClasses="LabelHeading"
               HorizontalAlignment="Center"
               Margin="0 5 0 10"/>

        <!-- Main purchase area: Left grid + Right detail (styled like ContrabandPermitConsoleWindow) -->
        <BoxContainer Orientation="Horizontal"
                      VerticalExpand="True"
                      HorizontalExpand="True">
            <!-- Left: Available boxes -->
            <BoxContainer Orientation="Vertical"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          MinWidth="320"
                          Margin="10 10 10 10">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="10">
                        <Label Text="{Loc 'safety-deposit-console-available-boxes'}"
                               StyleClasses="LabelHeading"
                               HorizontalAlignment="Center"/>
                        <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 10"/>
                        <GridContainer Name="AvailableBoxesGrid"
                                       Columns="2"
                                       HorizontalExpand="True"
                                       HSeparationOverride="8"
                                       VSeparationOverride="8"
                                       Margin="0 0 0 10"/>
                        <Label Text="{Loc 'safety-deposit-console-click-to-inspect'}"
                               StyleClasses="LabelSecondaryColor LabelSubText"
                               HorizontalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" VerticalExpand="True" SetWidth="2" Margin="0 10 0 10"/>

            <!-- Right: Detail panel + sprite -->
            <BoxContainer Orientation="Vertical"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          MinWidth="340"
                          Margin="10 10 10 10"
                          HorizontalAlignment="Center">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="10">
                        <Label HorizontalAlignment="Center"
                               Text="{Loc 'safety-deposit-console-box-details'}"
                               StyleClasses="LabelHeading"/>
                        <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 10"/>
                        <Label Name="SelectedBoxNameLabel"
                               HorizontalAlignment="Center"
                               StyleClasses="LabelHeading"
                               Margin="0 0 0 5"
                               Text="{Loc 'safety-deposit-console-select-a-box'}"/>
                        <Label Name="SelectedBoxDescriptionLabel"
                               HorizontalAlignment="Center"
                               StyleClasses="LabelSecondaryColor"
                               Margin="0 0 0 10"
                               Text="{Loc 'safety-deposit-console-select-to-view'}"/>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 10">
                            <Label Text="{Loc 'safety-deposit-console-price-label'}"
                                   StyleClasses="LabelHeading"
                                   VerticalAlignment="Center"/>
                            <Control HorizontalExpand="True"/>
                            <Label Name="SelectedBoxPriceLabel"
                                   Text="-"
                                   StyleClasses="LabelHeading"
                                   VerticalAlignment="Center"/>
                        </BoxContainer>
                        <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 10"/>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 4">
                            <Label Text="{Loc 'safety-deposit-console-your-balance'}"
                                   StyleClasses="LabelSubText"
                                   VerticalAlignment="Center"/>
                            <Control HorizontalExpand="True"/>
                            <Label Name="BankBalanceLabel"
                                   Text="$0"
                                   StyleClasses="LabelHeading"
                                   VerticalAlignment="Center"/>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 5">
                            <Label Text="{Loc 'safety-deposit-console-after-purchase'}"
                                   StyleClasses="LabelSecondaryColor"
                                   VerticalAlignment="Center"/>
                            <Control HorizontalExpand="True"/>
                            <Label Name="BalanceAfterLabel"
                                   Text="-"
                                   VerticalAlignment="Center"/>
                        </BoxContainer>
                        <Label Name="InsufficientFundsLabel"
                               Text="{Loc 'safety-deposit-console-insufficient-funds'}"
                               FontColorOverride="Red"
                               Visible="False"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 5"
                               StyleClasses="LabelSubText"/>
                    </BoxContainer>
                </PanelContainer>

                <!-- Sprite display (styled like ContrabandPermit PermitItemView) -->
                <PanelContainer Margin="10"
                                HorizontalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderThickness="3"
                                          BorderColor="#ffd688"
                                          BackgroundColor="#000000FF"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="4">
                        <EntityPrototypeView Name="SelectedBoxView"
                                             Margin="10 10 10 10"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             MinSize="192 192"
                                             Scale="4 4"
                                             Stretch="Fill"/>
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer HorizontalExpand="True"
                              Orientation="Vertical"
                              HorizontalAlignment="Center"
                              Margin="5 0 5 0">
                    <Button Name="BuyButton"
                            HorizontalExpand="True"
                            Margin="0 10 0 0"
                            SetHeight="40"
                            Text="{Loc 'safety-deposit-console-buy-button'}">
                        <TextureRect HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     SetSize="32 32"
                                     Stretch="KeepAspectCentered"
                                     TexturePath="/Textures/Interface/VerbIcons/plus.svg.192dpi.png"/>
                    </Button>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 5 0 5"/>

        <!-- Deposit Box Section (same #1B1B1E panel as ContrabandPermit left panel) -->
        <PanelContainer Margin="5 5 5 5">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="10" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center" HorizontalExpand="True">
                    <Label Text="{Loc 'safety-deposit-console-deposit-section'}"
                           StyleClasses="LabelHeading"
                           Margin="0 0 0 4"/>
                    <PanelContainer StyleClasses="LowDivider" Margin="0 2 0 4"/>
                    <Label Name="BoxSlotLabel"
                           Text="{Loc 'safety-deposit-console-no-box-in-slot'}"
                           StyleClasses="LabelSecondaryColor"/>
                </BoxContainer>
                <Button Name="DepositButton"
                        Text="{Loc 'safety-deposit-console-deposit-button'}"
                        VerticalAlignment="Center"
                        MinSize="140 35"
                        StyleClasses="OpenBoth"
                        Margin="10 0 0 0">
                    <TextureRect HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 SetSize="32 32"
                                 Stretch="KeepAspectCentered"
                                 TexturePath="/Textures/Interface/VerbIcons/eject.svg.192dpi.png"/>
                </Button>
            </BoxContainer>
        </PanelContainer>

        <!-- Owned Boxes List -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="5 5 5 0">
            <Label Text="{Loc 'safety-deposit-console-owned-boxes'}"
                   StyleClasses="LabelHeading"
                   Margin="0 0 0 5"/>
            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 5"/>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="OwnedBoxesContainer"
                              Orientation="Vertical"
                              VerticalExpand="True"
                              SeparationOverride="2"/>
            </ScrollContainer>
        </BoxContainer>

        <!-- Footer (like ContrabandPermit) -->
        <BoxContainer Orientation="Vertical" Margin="0 5 0 0">
            <PanelContainer StyleClasses="LowDivider"/>
            <BoxContainer Margin="10,2,5,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Label StyleClasses="WindowFooterText" Text="{Loc 'safety-deposit-console-header'}"/>
                <Control HorizontalExpand="True"/>
                <Label StyleClasses="WindowFooterText" Text="{Loc 'safety-deposit-console-bank-payment-note'}"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
